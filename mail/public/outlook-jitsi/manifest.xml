<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="MailApp">
  <Id>8f3c2a91-6b14-4d7e-9e20-a4c5b8d1e7f0</Id>
  <Version>1.0.0</Version>
  <ProviderName>alexol.io</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="Встреча Jitsi"/>
  <Description DefaultValue="Вставляет ссылку видеозвонка meet.alexol.io в поле Место."/>
  <IconUrl DefaultValue="https://mail.alexol.io/favicon-32x32.png"/>
  <HighResolutionIconUrl DefaultValue="https://mail.alexol.io/favicon.png"/>
  <SupportUrl DefaultValue="https://mail.alexol.io"/>
  <AppDomains>
    <AppDomain>https://mail.alexol.io</AppDomain>
    <AppDomain>https://meet.alexol.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://mail.alexol.io/outlook-jitsi/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFile"/>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="jitsiGroup">
                <Label resid="groupLabel"/>
                <Control xsi:type="Button" id="jitsiButton">
                  <Label resid="buttonLabel"/>
                  <Supertip>
                    <Title resid="buttonLabel"/>
                    <Description resid="buttonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>insertJitsi</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://mail.alexol.io/favicon-16x16.png"/>
        <bt:Image id="icon32" DefaultValue="https://mail.alexol.io/favicon-32x32.png"/>
        <bt:Image id="icon80" DefaultValue="https://mail.alexol.io/favicon.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="functionFile" DefaultValue="https://mail.alexol.io/outlook-jitsi/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Jitsi"/>
        <bt:String id="buttonLabel" DefaultValue="Встреча Jitsi"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonTip" DefaultValue="Вставить ссылку видеозвонка в поле Место"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
