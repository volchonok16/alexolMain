# Для автодеплоя: GitHub Secret jitsi_env.
CONFIG=/var/www/jitsi/.jitsi-meet-cfg
TZ=Europe/Moscow
PUBLIC_URL=https://meet.alexol.io
DISABLE_HTTPS=1
ENABLE_LETSENCRYPT=0
ENABLE_HTTP_REDIRECT=0
ENABLE_HSTS=0
ENABLE_XMPP_WEBSOCKET=1
ENABLE_P2P=1
ENABLE_WELCOME_PAGE=1
ENABLE_PREJOIN_PAGE=0
ENABLE_REQUIRE_DISPLAY_NAME=0
DEFAULT_LANGUAGE=ru
# JWT: тот же JWT_APP_SECRET, что JITSI_JWT_APP_SECRET в MAIL_ENV.
# Пока секрет пустой, ENABLE_AUTH остаётся 0 (гости без токена).
# Гостей пускаем через JWT на /jitsi-auth, не в анонимный lobby «ждём организатора».
ENABLE_AUTH=0
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID=alexol
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=alexol
JWT_ACCEPTED_AUDIENCES=alexol
JWT_ALLOW_EMPTY=0
ENABLE_AUTO_OWNER=1
TOKEN_AUTH_URL=https://mail.alexol.io/jitsi-auth?room={room}
TOKEN_AUTH_URL_AUTO_REDIRECT=1
JVB_PORT=10001
# Публичный IP и UDP-порт JVB. 10000/udp на этом VPS занят. Кавычки обязательны из-за #.
JVB_ADVERTISE_IPS=
JVB_DISABLE_STUN=1
RESTART_POLICY=unless-stopped
JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=stable

JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
