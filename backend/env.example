# ============================================
# Mail sync + SSO (admin ↔ mail) — двусторонняя интеграция
# ============================================
# HTTP sync по Docker-сети alexol_mail_sync (общий секрет, без gRPC):
#   admin → mail:  MAIL_API_URL + X-Mail-Sync-Key
#   mail  → admin: ALEXOL_API_URL (в mail-server/.env) + тот же MAIL_SYNC_SECRET
#
# Из Docker-сети backend → контейнер mail_backend
MAIL_API_URL=http://mail_backend:8000
# Тот же секрет, что в mail-server/.env (обязателен для sync + SSO)
MAIL_SYNC_SECRET=change-me-mail-sync-secret
MAIL_DOMAIN=alexol.io
# Важно: alexol_backend и mail_backend в сети alexol_mail_sync

# ============================================
# Bot -> Backend news integration
# ============================================
BACKEND_API_URL=http://backend:3000/api
BACKEND_ADMIN_LOGIN=alex
BACKEND_ADMIN_PASSWORD=Triu546r!)

# ============================================
# MinIO (видео курсов)
# ============================================
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=courses
MINIO_PUBLIC_URL=http://minio.alexol.io
MINIO_MAX_VIDEO_SIZE_MB=10240
