# Database
POSTGRES_USER=alexol_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=alexol_db

# Application
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://alexol_user:your_secure_password_here@postgres:5432/alexol_db

# JWT
JWT_SECRET=your_very_secure_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS (можно указать несколько адресов через запятую)
CORS_ORIGIN=https://alexol.io,https://admin.alexol.io,http://localhost:5173,http://localhost:5174,https://api.alexol.io

# Public URL of API (used by Swagger "servers")
PUBLIC_API_URL=https://api.alexol.io

# ============================================
# Telegram (backend notifications / contact)
# ============================================
TELEGRAM_BOT_TOKEN=7084328386:AAGSdMpcpCU1MZQ0Vl3QIsc5W5mv-8rZZ04
TELEGRAM_CHAT_ID=-5103386537
TELEGRAM_REQUESTS_CHAT_ID=-5103386537

# ============================================
# Bot env (projects/bot) - optional "common env"
# ============================================
# Токен отдельного бота только для постинга в канал (добавьте в реальный .env на сервере).
# Канал тот же — ниже TELEGRAM_CHANNEL_ID один на всех; второй ID не нужен.
# Бот с этим токеном должен быть админом канала. Заявки и polling — через TELEGRAM_BOT_TOKEN выше.
TELEGRAM_NEWS_BOT_TOKEN=your-telegram-news-bot-token

# Новостной канал (chat id). Пример: -1002187808095.
# Можно @username или числовой ID; для приватных каналов обычно -100xxxxxxxxxxxx.
TELEGRAM_CHANNEL_ID=-1002187808095

# OpenRouter (AI rewrite)
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-qwen-32b

# Часовые окна публикации новостей (4 раза в день).
# Формат: начало_часа-конец_часа через запятую. Внутри каждого окна выбирается случайная минута.
NEWS_WINDOWS=10-11,14-15,18-19,22-23
TIMEZONE=Europe/Moscow
TDATA_PATH=tdata

# VK (optional)
VK_ACCESS_TOKEN=vk1.a.your_community_token_here
VK_GROUP_ID=123456789

# ============================================
# Bot -> Backend news integration (optional)
# ============================================
# If set, bot will create news in admin panel via backend API.
#
# Recommended on the same server (inside this docker-compose): use internal HTTP URL
# to avoid public SSL/certificate issues:
BACKEND_API_URL=http://backend:3000/api
BACKEND_ADMIN_LOGIN=alex
BACKEND_ADMIN_PASSWORD=Triu546r!)