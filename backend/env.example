# Скопируй: cp env.example .env  и подставь свои значения.
# Файл .env не коммить.

# ============================================
# Database
# ============================================
POSTGRES_USER=alexol_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=alexol_db

# Application
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://alexol_user:your_secure_password_here@postgres:5432/alexol_db

# JWT
JWT_SECRET=your_very_secure_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://alexol.io,https://admin.alexol.io,https://mail.alexol.io,http://localhost:5173,http://localhost:5174,https://api.alexol.io

# Public URL of API
PUBLIC_API_URL=https://api.alexol.io

# ============================================
# Telegram (backend notifications / contact)
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_REQUESTS_CHAT_ID=your_telegram_requests_chat_id

# ============================================
# Bot env (news / requests / speak)
# ============================================
TELEGRAM_NEWS_BOT_TOKEN=your_news_bot_token
TELEGRAM_CHANNEL_ID=your_channel_id

# ============================================
# Alexol Speak
# ============================================
SPEAK_BOT_TOKEN=your_speak_bot_token
SPEAK_WEBAPP_URL=https://lang.alexol.io

SPEAK_STT_BACKEND=local
SPEAK_WHISPER_LOCAL_MODEL=small

SPEAK_TTS_MODEL=deepgram/flux-tts:free
SPEAK_TTS_VOICE=flux-kit-en
SPEAK_TTS_PROVIDERS=openrouter,gtts
SPEAK_TTS_SPEED_DEFAULT=0.95

SPEAK_OPENROUTER_MODEL=qwen/qwen3.6-plus:free
SPEAK_OPENROUTER_FALLBACK_MODELS=qwen/qwen3.6-plus:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,nvidia/nemotron-3-nano-30b-a3b:free

# ============================================
# OpenRouter (новости + Speak)
# ============================================
# Из РФ часто 403 "Access denied by security policy" — нужен прокси вне РФ:
# OPENROUTER_HTTP_PROXY=http://user:pass@host:port
# или HTTPS_PROXY=http://user:pass@host:port
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,poolside/laguna-xs.2:free,openrouter/free,qwen/qwen3.6-plus:free,qwen/qwen3-next-80b-a3b-instruct:free,qwen/qwen3-coder:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free,meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_HTTP_PROXY=

NEWS_WINDOWS=10-11,14-15,18-19,22-23
TIMEZONE=Europe/Moscow
TDATA_PATH=tdata

# VK (optional)
VK_ACCESS_TOKEN=vk1.a.your_community_token_here
VK_GROUP_ID=123456789

# ============================================
# Mail sync + SSO (admin ↔ mail)
# ============================================
# Из Docker-сети backend → контейнер mail_backend (сеть alexol_mail_sync)
MAIL_API_URL=http://mail_backend:8000
# ТОТ ЖЕ секрет, что MAIL_SYNC_SECRET в mail-server/.env
MAIL_SYNC_SECRET=change-me-mail-sync-secret
MAIL_DOMAIN=alexol.io

# ============================================
# Bot -> Backend news integration
# ============================================
BACKEND_API_URL=http://backend:3000/api
BACKEND_ADMIN_LOGIN=user
BACKEND_ADMIN_PASSWORD=your_admin_password_here

# ============================================
# MinIO (видео курсов)
# ============================================
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=courses
MINIO_PUBLIC_URL=http://minio.alexol.io
MINIO_MAX_VIDEO_SIZE_MB=10240
