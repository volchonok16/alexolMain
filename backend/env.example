# Скопируй на сервер: cp env.example .env
# Файл .env в git не коммить.

# Database
POSTGRES_USER=alexol_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=alexol_db

# Application
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://alexol_user:your_secure_password_here@postgres:5432/alexol_db

# JWT
JWT_SECRET=your_very_secure_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://alexol.io,https://admin.alexol.io,https://mail.alexol.io,http://localhost:5173,http://localhost:5174,https://api.alexol.io

# Public URL of API
PUBLIC_API_URL=https://api.alexol.io

