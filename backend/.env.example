NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://alexol.io,https://admin.alexol.io,https://api.alexol.io
PUBLIC_API_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
MINIO_ENDPOINT=localhost
# In Docker Compose this is remapped to the `minio` service automatically.
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=courses
# Локально: http://localhost:9000
# На сервере до сертификата: http://minio.alexol.io
# После certbot: https://minio.alexol.io
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_MAX_VIDEO_SIZE_MB=10240
