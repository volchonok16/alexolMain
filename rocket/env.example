# GitHub Actions secret name: ROCKET_ENV
# Repo → Settings → Secrets and variables → Actions → New secret → ROCKET_ENV
# Вставь этот файл целиком (как MAIL_ENV / jitsi_env).
#
# OAUTH_ROCKETCHAT_CLIENT_SECRET должен совпадать с MAIL_ENV.
# JITSI_JWT_APP_SECRET должен совпадать с jitsi_env (JWT_APP_SECRET) и MAIL_ENV.

ROOT_URL=https://chat.alexol.io
HOST_PORT=18300
RELEASE=8.0.1
# Show_Setup_Wizard already completed. Do not keep Register_Server=false:
# Community cannot enable private zip apps (Apps_Error_license-prevented).
# Jitsi must come from Marketplace, which needs a one-time workspace registration.
OVERWRITE_SETTING_Show_Setup_Wizard=completed

# Первый админ workspace (создаётся configure.sh при пустой базе)
ADMIN_USERNAME=admin
ADMIN_PASS=
ADMIN_EMAIL=admin@alexol.io
ADMIN_NAME=Alexol Admin

# SSO: тот же client, что в MAIL_ENV
MAIL_PUBLIC_URL=https://mail.alexol.io
OAUTH_ROCKETCHAT_CLIENT_ID=alexol-chat
OAUTH_ROCKETCHAT_CLIENT_SECRET=

# Jitsi из чата: тот же секрет, что JWT_APP_SECRET у Jitsi
JITSI_PUBLIC_URL=https://meet.alexol.io
JITSI_JWT_APP_ID=alexol
JITSI_JWT_APP_SECRET=

# LDAP: форма чата проверяет тот же пароль, что у ящика (mail :389).
# BIND — почтовый админ. При деплое stitch-deploy-env.sh подставляет
# MAIL_LDAP_BIND_PASSWORD из DEFAULT_ADMIN_PASSWORD (MAIL_ENV), если пусто.
MAIL_LDAP_HOST=host.docker.internal
MAIL_LDAP_PORT=389
MAIL_LDAP_BIND_DN=admin@alexol.io
MAIL_LDAP_BIND_PASSWORD=
MAIL_LDAP_BASE_DN=dc=alexol,dc=io

# 2FA / уведомления чата: ящик chat@alexol.io (пароль только в GitHub secret ROCKET_ENV)
SMTP_HOST=mail.alexol.io
SMTP_PORT=587
SMTP_USERNAME=chat@alexol.io
SMTP_PASSWORD=
FROM_EMAIL=Support Chat <chat@alexol.io>
SMTP_PROTOCOL=smtp
