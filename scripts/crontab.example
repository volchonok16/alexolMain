# Ежедневные бэкапы в 23:59 MSK.
# Установка на сервере:
#   crontab -e
# и вставить строки ниже (пути поправь под свой сервер).
#
# Ручной запуск:
#   cd /var/www/alexol.io/back && docker compose --profile backup run --rm backup
#   cd /var/www/alexol.io/mail-server && docker compose --profile backup run --rm backup
#
# Восстановление на новом сервере (сначала postgres, minio остановлен):
#   docker compose stop minio backend
#   docker compose --profile backup run --rm restore
#   docker compose up -d

59 23 * * * cd /var/www/alexol.io/back && docker compose --profile backup run --rm backup >> /var/log/alexol-backup.log 2>&1
59 23 * * * cd /var/www/alexol.io/mail-server && docker compose --profile backup run --rm backup >> /var/log/mail-backup.log 2>&1
