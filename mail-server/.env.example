# Скопируй: cp .env.example .env  и подставь значения.
# MAIL_SYNC_SECRET должен совпадать с backend/.env (alexolMain).

MAIL_SYNC_SECRET=change-me-mail-sync-secret

# Reverse sync: mail → admin (создание/правка пользователей)
# Контейнер alexol_backend в сети alexol_mail_sync
ALEXOL_API_URL=http://alexol_backend:3000

# Опционально переопределить дефолты из docker-compose.yml:
# SECRET_KEY=your-mail-jwt-secret-min-32-chars
# DEFAULT_ADMIN_EMAIL=admin@alexol.io
# DEFAULT_ADMIN_PASSWORD=your_mail_admin_password
# MAIL_DOMAIN=alexol.io
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SMTP relay (если не шлёте напрямую по MX):
# SMTP_RELAY_ENABLED=true
# SMTP_RELAY_HOST=smtp.example.com
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASSWORD=
# SMTP_RELAY_USE_TLS=true
