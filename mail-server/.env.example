# GitHub Actions secret name: MAIL_ENV
# Repo → Settings → Secrets and variables → Actions → New secret → MAIL_ENV
# Вставь сюда содержимое целиком (как ENV_BE для backend).
#
# MAIL_SYNC_SECRET должен совпадать с backend/.env (секрет ENV_BE).

MAIL_SYNC_SECRET=change-me-mail-sync-secret

# Reverse sync: mail → admin (сеть alexol_mail_sync)
ALEXOL_API_URL=http://alexol_backend:3000

# JWT / admin mailbox (переопределяют дефолты docker-compose)
SECRET_KEY=your-mail-jwt-secret-min-32-chars
DEFAULT_ADMIN_EMAIL=admin@alexol.io
DEFAULT_ADMIN_PASSWORD=your_mail_admin_password
MAIL_DOMAIN=alexol.io
MAIL_HOSTNAME=mail.alexol.io
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAIL_PUBLIC_URL=https://mail.alexol.io

# Jitsi: то же значение, что JWT_APP_SECRET в jitsi_env
JITSI_PUBLIC_URL=https://meet.alexol.io
JITSI_JWT_APP_ID=alexol
JITSI_JWT_APP_SECRET=

# Rocket.Chat SSO (тот же client id/secret, что в GitHub secret ROCKET_ENV)
CHAT_PUBLIC_URL=https://chat.alexol.io
OAUTH_ROCKETCHAT_CLIENT_ID=alexol-chat
OAUTH_ROCKETCHAT_CLIENT_SECRET=
# Все OAuth-клиенты через запятую (чат + Atlassian)
OAUTH_CLIENT_IDS=alexol-chat,alexol-atlassian,alexol-jira,alexol-confluence,alexol-bitbucket,alexol-bamboo
# Отдельный секрет для Jira / Confluence / Bitbucket (не секрет чата)
OAUTH_ATLASSIAN_CLIENT_SECRET=
# Jira Software: jira-software-users (не jira-users). Bitbucket: stash-users.
OAUTH_ATLASSIAN_GROUPS=jira-software-users,confluence-users,stash-users
OAUTH_ATLASSIAN_GROUPS_JIRA=jira-software-users
OAUTH_ATLASSIAN_GROUPS_CONFLUENCE=confluence-users
OAUTH_ATLASSIAN_GROUPS_BITBUCKET=stash-users
OAUTH_ATLASSIAN_GROUPS_BAMBOO=bamboo-users
# Mail is_admin=true → extra groups on SSO login (Jira/Confluence overwrite groups from IdP)
OAUTH_ATLASSIAN_GROUPS_JIRA_ADMIN=jira-administrators
OAUTH_ATLASSIAN_GROUPS_CONFLUENCE_ADMIN=confluence-administrators
OAUTH_ATLASSIAN_GROUPS_BAMBOO_ADMIN=bamboo-admin
# Все callback URI через запятую. Чат: /_oauth/alexol (не /_oauth/oidc)
OAUTH_ROCKETCHAT_REDIRECT_URI=https://chat.alexol.io/_oauth/alexol,https://jira.alexol.io/plugins/servlet/oidc/callback,https://confluence.alexol.io/plugins/servlet/oidc/callback,https://bitbucket.alexol.io/plugins/servlet/oidc/callback,https://bamboo.alexol.io/plugins/servlet/oidc/callback
JIRA_PUBLIC_URL=https://jira.alexol.io
CONFLUENCE_PUBLIC_URL=https://confluence.alexol.io
BITBUCKET_PUBLIC_URL=https://bitbucket.alexol.io
BAMBOO_PUBLIC_URL=https://bamboo.alexol.io

# Чат подтягивает фото/телефон/должность/telegram в профиль RC.
# При деплое stitch-deploy-env.sh подставляет ROCKETCHAT_ADMIN_PASSWORD
# из ADMIN_PASS (ROCKET_ENV), если пусто.
ROCKETCHAT_API_URL=http://rocket_chat:3000
ROCKETCHAT_ADMIN_USERNAME=admin
ROCKETCHAT_ADMIN_PASSWORD=

# SMTP relay (опционально; иначе прямая отправка по MX)
# SMTP_RELAY_ENABLED=false
# SMTP_RELAY_HOST=
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASSWORD=
# SMTP_RELAY_USE_TLS=true

# DKIM (свой ключ). Генерация: python3 scripts/generate_dkim.py
# Cloudflare: TXT Name=default._domainkey  Content=v=DKIM1; k=rsa; p=...
DKIM_ENABLED=true
DKIM_SELECTOR=default
DKIM_PRIVATE_KEY_PATH=/etc/dkim/private.pem
