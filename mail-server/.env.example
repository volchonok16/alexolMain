# GitHub Actions secret name: MAIL_ENV
# Repo → Settings → Secrets and variables → Actions → New secret → MAIL_ENV
# Вставь сюда содержимое целиком (как ENV_BE для backend).
#
# MAIL_SYNC_SECRET должен совпадать с backend/.env (секрет ENV_BE).

MAIL_SYNC_SECRET=change-me-mail-sync-secret

# Reverse sync: mail → admin (сеть alexol_mail_sync)
ALEXOL_API_URL=http://alexol_backend:3000

# JWT / admin mailbox (переопределяют дефолты docker-compose)
SECRET_KEY=your-mail-jwt-secret-min-32-chars
DEFAULT_ADMIN_EMAIL=admin@alexol.io
DEFAULT_ADMIN_PASSWORD=your_mail_admin_password
MAIL_DOMAIN=alexol.io
MAIL_HOSTNAME=mail.alexol.io
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAIL_PUBLIC_URL=https://mail.alexol.io

# Jitsi: то же значение, что JWT_APP_SECRET в jitsi_env
JITSI_PUBLIC_URL=https://meet.alexol.io
JITSI_JWT_APP_ID=alexol
JITSI_JWT_APP_SECRET=

# Rocket.Chat SSO (тот же client id/secret, что в GitHub secret ROCKET_ENV)
CHAT_PUBLIC_URL=https://chat.alexol.io
OAUTH_ROCKETCHAT_CLIENT_ID=alexol-chat
OAUTH_ROCKETCHAT_CLIENT_SECRET=
OAUTH_ROCKETCHAT_REDIRECT_URI=https://chat.alexol.io/_oauth/alexol

# Чат подтягивает фото/телефон/должность/telegram в профиль RC (пароль админа чата).
# Пустой ROCKETCHAT_ADMIN_PASSWORD → DEFAULT_ADMIN_PASSWORD.
ROCKETCHAT_API_URL=http://host.docker.internal:18300
ROCKETCHAT_ADMIN_USERNAME=admin
ROCKETCHAT_ADMIN_PASSWORD=

# SMTP relay (опционально; иначе прямая отправка по MX)
# SMTP_RELAY_ENABLED=false
# SMTP_RELAY_HOST=
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASSWORD=
# SMTP_RELAY_USE_TLS=true

# DKIM (свой ключ). Генерация: python3 scripts/generate_dkim.py
# Cloudflare: TXT Name=default._domainkey  Content=v=DKIM1; k=rsa; p=...
DKIM_ENABLED=true
DKIM_SELECTOR=default
DKIM_PRIVATE_KEY_PATH=/etc/dkim/private.pem
